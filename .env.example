# API Keys (Provide at least one of these for real LLM evaluations)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Judge portal login password
JUDGE_PORTAL_PASSWORD=your_portal_password_here

# Default LLM configurations
DEFAULT_PROVIDER=openai  # options: openai, anthropic, mock
DEFAULT_MODEL=gpt-4-turbo  # options: gpt-4-turbo, gpt-3.5-turbo, claude-3-opus-20240229, etc.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Explicit mock mode is still available by setting DEFAULT_PROVIDER=mock.
USE_MOCK_FALLBACK=True

# Databricks SQL warehouse settings
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/primary_warehouse_id
DATABRICKS_BACKUP_WAREHOUSE_ID=backup_warehouse_id
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_CATALOG=sandbox
DATABRICKS_SCHEMA=ai_eval_judge_portal
